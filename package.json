    "@fullcalendar/timegrid": "^6.1.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.0.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.51.0",
    "next": "^16.0.0",
    "nodemailer": "^7.0.0",
    "pg": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
