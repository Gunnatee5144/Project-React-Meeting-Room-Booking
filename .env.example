# Copy to .env. No database is needed to run placeholder pages.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_room_booking?schema=public"

# Reserved for the authentication and email branches; not used by this scaffold.
SESSION_SECRET=""
# Gun's read-only session adapter accepts an HS256 JWT with sub and exp claims.
# The authentication owner issues this HttpOnly cookie; secret needs 32+ characters.
SESSION_COOKIE_NAME="session"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
