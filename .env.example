# Copy to .env. Placeholder pages that do not read the database run without it, but login,
# register, rooms and bookings need DATABASE_URL and SESSION_SECRET.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/meeting_room_booking?schema=public"
# Managed PostgreSQL with a private CA (e.g. Aiven): paste the CA certificate (PEM) here, with
# newlines written as \n. Leave empty for local PostgreSQL.
DATABASE_CA_CERT=""

# Signs the session cookie (HS256 JWT). Required, 32+ characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs every user out. Never commit the real value.
SESSION_SECRET=""
SESSION_COOKIE_NAME="session"

# Passwords used by `npm run db:seed`. Defaults exist only for a local database; a non-local
# database refuses to seed unless both are set.
SEED_USER_PASSWORD=""
SEED_ADMIN_PASSWORD=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
